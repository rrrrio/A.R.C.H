[Unit]
Description=A.R.C.H. video avatar renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment=@EXECUTION_PATH@
Environment=PYTHONPATH=@AVATAR_RUNTIME_SOURCE@
ExecStart=@MUSETALK_PYTHON@ -m avatar_runtime.worker --socket @AVATAR_SOCKET@ --source @AVATAR_SOURCE_VIDEO@ --fps @AVATAR_FPS@ --backend @AVATAR_WORKER_BACKEND@ --model-root @AVATAR_MODEL_ROOT@ --cache-dir @AVATAR_CACHE_DIR@ --musetalk-source @AVATAR_MUSETALK_SOURCE@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=8G
MemoryMax=12G
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@AVATAR_RUNTIME_DIR@
ReadOnlyPaths=@AVATAR_SOURCE_PATH@ @AVATAR_MODEL_PATH@ @AVATAR_MUSETALK_SOURCE_PATH@

[Install]
WantedBy=default.target
