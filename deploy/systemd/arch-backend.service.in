[Unit]
Description=A.R.C.H. local backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment=PATH=@EXECUTION_PATH@
ExecStart=@UV_BIN@ run --directory backend uvicorn arch.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
