# The application resolves all writable runtime paths beneath this directory.
LVA_DATA_DIR=data
LVA_ENVIRONMENT=development
LVA_HOST=127.0.0.1
LVA_PORT=8000
LVA_PUBLIC_ORIGIN=https://local-voice-agent.local:8443
# Keep internet search off unless the local SearXNG service is intentionally started.
LVA_SEARCH_ENABLED=false
LVA_SEARXNG_ENDPOINT=http://127.0.0.1:8080

# Used by the browser-facing Caddy deployment in later milestones.
LVA_LAN_HOST=local-voice-agent.local
LVA_HTTPS_PORT=8443
