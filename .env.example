# The application resolves all writable runtime paths beneath this directory.
ARCH_DATA_DIR=data
ARCH_ENVIRONMENT=development
ARCH_HOST=127.0.0.1
ARCH_PORT=8000
ARCH_PUBLIC_ORIGIN=https://arch.local:8443
# Keep internet search off unless the local SearXNG service is intentionally started.
ARCH_SEARCH_ENABLED=false
ARCH_SEARXNG_ENDPOINT=http://127.0.0.1:8080

# Used by the browser-facing Caddy deployment in later milestones.
ARCH_LAN_HOST=arch.local
ARCH_HTTPS_PORT=8443

# Existing LVA_* names remain accepted as compatibility aliases.
